{
  "name": "nuget-assistant",
  "displayName": "NuGet Assistant",
  "description": "Manage NuGet packages graphically in VS Code. Search, install, update, and remove packages from .NET projects and solutions.",
  "version": "2.0.0",
  "icon": "images/logo.png",
  "publisher": "claudineyqr",
  "author": {
    "name": "Claudiney Queiroz",
    "url": "https://github.com/claudineyqr"
  },
  "engines": {
    "vscode": "^1.82.0"
  },
  "main": "./dist/src/extension/extension.js",
  "categories": [
    "Other"
  ],
  "keywords": [
    "nuget",
    "package",
    "package-manager",
    "dotnet",
    "csharp",
    "c#",
    "dependency",
    "dependencies",
    "explorer",
    "solution"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/claudineyqr/vscode-nuget-assistant.git"
  },
  "license": "SEE LICENSE IN LICENSE",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "%capabilities.untrustedWorkspaces.description%"
    }
  },
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "nuget-assistant.managePackages",
        "title": "%command.manageProjectPackages%"
      },
      {
        "command": "nuget-assistant.managePackagesPalette",
        "title": "%command.manageProjectPackages%"
      },
      {
        "command": "nuget-assistant.manageSolutionPackages",
        "title": "%command.manageSolutionPackages%"
      },
      {
        "command": "nuget-assistant.manageSolutionPackagesPalette",
        "title": "%command.manageSolutionPackages%"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "nuget-assistant.managePackages",
          "when": "false"
        },
        {
          "command": "nuget-assistant.managePackagesPalette"
        },
        {
          "command": "nuget-assistant.manageSolutionPackagesPalette"
        }
      ],
      "explorer/context": [
        {
          "when": "resourceExtname == .csproj || resourceExtname == .vbproj || resourceExtname == .fsproj",
          "command": "nuget-assistant.managePackages",
          "group": "navigation"
        },
        {
          "when": "resourceExtname == .sln || resourceExtname == .slnx",
          "command": "nuget-assistant.manageSolutionPackages",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "NuGet Assistant",
      "properties": {
        "nuget-assistant.allowInsecureHttpCredentials": {
          "order": 1,
          "type": "boolean",
          "default": false,
          "scope": "window",
          "description": "%setting.allowInsecureHttpCredentials%"
        },
        "nuget-assistant.loggingLevel": {
          "order": 2,
          "type": "string",
          "enum": [
            "None",
            "Information",
            "Error",
            "Debug"
          ],
          "enumDescriptions": [
            "%setting.loggingLevel.none%",
            "%setting.loggingLevel.information%",
            "%setting.loggingLevel.error%",
            "%setting.loggingLevel.debug%"
          ],
          "default": "None",
          "scope": "window",
          "description": "%setting.loggingLevel%"
        },
        "nuget-assistant.debugResponseBodyLimitKb": {
          "order": 3,
          "type": "number",
          "default": 32,
          "minimum": 0,
          "maximum": 5120,
          "scope": "window",
          "description": "%setting.debugResponseBodyLimitKb%"
        },
        "nuget-assistant.language": {
          "order": 4,
          "type": "string",
          "enum": [
            "auto",
            "en",
            "pt-BR",
            "zh-CN"
          ],
          "default": "auto",
          "scope": "window",
          "enumDescriptions": [
            "%setting.language.auto%",
            "%setting.language.en%",
            "%setting.language.ptBR%",
            "%setting.language.zhCN%"
          ],
          "description": "%setting.language%"
        },
        "nuget-assistant.packageExecutionMode": {
          "order": 5,
          "type": "string",
          "enum": [
            "dotnet",
            "projectFile"
          ],
          "enumDescriptions": [
            "%setting.packageExecutionMode.dotnet%",
            "%setting.packageExecutionMode.projectFile%"
          ],
          "default": "projectFile",
          "scope": "window",
          "description": "%setting.packageExecutionMode%"
        },
        "nuget-assistant.showTaskWindow": {
          "order": 6,
          "type": "boolean",
          "default": false,
          "scope": "window",
          "description": "%setting.showTaskWindow%"
        }
      }
    }
  },
  "scripts": {
    "start": "ng serve",
    "build": "ng build --configuration development && tsc -p tsconfig.ext.json",
    "angular-prod": "ng build --configuration production",
    "i18n:extract": "ng extract-i18n --format=json --out-file messages.en.json --output-path src/app/i18n",
    "package": "vsce package",
    "publish": "vsce publish",
    "package-ext": "webpack --mode production --devtool hidden-source-map",
    "package-all": "npm run angular-prod && npm run package-ext",
    "vscode:prepublish": "npm run package-all",
    "lint": "ng lint",
    "test": "jest",
    "test:e2e": "node tests/vscode/runTest.cjs",
    "test-coverage": "jest --coverage",
    "sonar-scan": "sonar-scanner-npm"
  },
  "dependencies": {
    "@angular/common": "^22.2.6",
    "@angular/compiler": "^22.2.6",
    "@angular/core": "^22.2.6",
    "@angular/forms": "^22.2.6",
    "@angular/localize": "^22.2.6",
    "@angular/platform-browser": "^22.2.6",
    "@angular/router": "^22.2.6",
    "@fortawesome/angular-fontawesome": "^5.1.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "angular-split": "^20.0.0",
    "compare-versions": "^6.1.1",
    "rxjs": "^7.8.2",
    "tslib": "^2.9.1",
    "xml2js": "^0.6.2",
    "zone.js": "^0.16.3"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^22.7.0",
    "@angular-eslint/schematics": "^22.7.0",
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.6",
    "@eslint/js": "^10.0.1",
    "@sonar/scan": "^5.1.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/jest": "^30.0.0",
    "@types/node": "24.x",
    "@types/vscode": "1.82.0",
    "@types/mocha": "^10.0.10",
    "@types/xml2js": "^0.4.14",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.1",
    "angular-eslint": "^22.7.0",
    "eslint": "^10.15.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jest-preset-angular": "^17.0.3",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "ts-loader": "^9.6.2",
    "typescript-eslint": "^8.73.0",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1"
  },
  "overrides": {
    "serialize-javascript": "^7.1.4"
  },
  "jest": {
    "preset": "jest-preset-angular",
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/jest-global-mocks.ts"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/dist/",
      "<rootDir>/node_modules/"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/setup-jest.ts"
    ]
  }
}